# Botchain Testnet Configuration
BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life

# Deployed Smart Contract Address (fill after running deployment script)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Optional: Reown / WalletConnect Cloud Project ID (get from https://cloud.reown.com)
# If left empty, fallback injected connectors (MetaMask, Rabby, etc.) will still work seamlessly!
NEXT_PUBLIC_PROJECT_ID=

# Private key for deploying the contract to Botchain Testnet (DO NOT SHARE OR COMMIT)
PRIVATE_KEY=
