# Botchain Mainnet Configuration
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# Deployed Smart Contract Address (Botchain Mainnet)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x3ECA8573925E2d5d6DF0458EDC09c29d7f6f3D55

# Optional: Reown / WalletConnect Cloud Project ID (get from https://cloud.reown.com)
# If left empty, fallback injected connectors (MetaMask, Rabby, etc.) will still work seamlessly!
NEXT_PUBLIC_PROJECT_ID=

# Private key for deploying the contract to Botchain Mainnet (DO NOT SHARE OR COMMIT)
PRIVATE_KEY=
